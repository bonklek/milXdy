{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milxdy.local/schemas/local-app-package.schema.json",
  "title": "milXdy Local App Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "description",
    "packageKind",
    "sdk",
    "contentEntry",
    "defaultEnabled",
    "storageKeys",
    "surfaces",
    "cost",
    "loadTriggers",
    "hub",
    "privacy",
    "package"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "packageKind": { "enum": ["app", "feature", "theme"] },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minVersion"],
      "properties": {
        "minVersion": { "type": "string" },
        "targetVersion": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "contentEntry": {
      "allOf": [
        { "$ref": "#/$defs/relativePath" },
        { "pattern": "\\.m?js$" }
      ]
    },
    "css": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "dock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "icon": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "light": { "$ref": "#/$defs/relativePath" },
                "dark": { "$ref": "#/$defs/relativePath" }
              }
            }
          ]
        },
        "defaultSide": { "enum": ["left", "right"] }
      }
    },
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativeStyle", "supportedStyles"],
      "properties": {
        "nativeStyle": { "enum": ["native", "reminet", "classic", "maxxer", "reader", "miladychan", "music", "wiki"] },
        "supportedStyles": {
          "type": "array",
          "items": { "enum": ["native", "reminet", "classic", "maxxer", "reader", "miladychan", "music", "wiki"] },
          "minItems": 1
        },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "defaultEnabled": { "type": "boolean" },
    "storageKeys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": { "$ref": "#/$defs/stringArray" },
        "sync": { "$ref": "#/$defs/stringArray" }
      }
    },
    "settings": {
      "type": "array",
      "items": { "$ref": "#/$defs/setting" }
    },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface" }
    },
    "deliverySurfaces": {
      "type": "array",
      "items": { "enum": ["tweet", "xArticle", "userCell", "notification", "directMessage", "profile"] }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["runtime", "invoked"] },
        "invokedBy": { "enum": ["userAction"] },
        "ownerAppId": { "type": "string" },
        "reason": { "type": "string" },
        "localOnly": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "siteScopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "hosts", "integration", "surfaces"],
        "properties": {
          "site": { "enum": ["x", "remiliaNet", "remiliaWiki", "miladychan"] },
          "hosts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(https?|wss)://[^/*\\s/?#@:]+(?::[0-9]+)?/\\*$" },
            "minItems": 1
          },
          "integration": { "enum": ["contentScript", "backgroundService", "embeddedFrame", "overlayApp"] },
          "surfaces": {
            "type": "array",
            "items": { "$ref": "#/$defs/surface" },
            "minItems": 1
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path"],
              "properties": {
                "type": { "enum": ["exact", "prefix"] },
                "path": { "type": "string", "pattern": "^/" },
                "surface": { "$ref": "#/$defs/surface" }
              }
            }
          },
          "presentation": { "enum": ["sideRailOverlay", "hostRouteOverlay", "userAction"] },
          "notes": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "perSurface", "network", "worker", "domWrite"],
      "properties": {
        "startup": { "enum": ["cheap", "moderate", "heavy"] },
        "perSurface": { "enum": ["cheap", "moderate", "heavy"] },
        "network": { "enum": ["none", "batched", "eager"] },
        "worker": { "enum": ["none", "optional", "heavy"] },
        "domWrite": { "enum": ["small", "moderate", "large"] }
      }
    },
    "loadTriggers": {
      "type": "array",
      "items": { "enum": ["startup", "surface", "dockOpen", "idle", "userAction"] },
      "minItems": 1
    },
    "hub": { "$ref": "#/$defs/hub" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(https?|wss)://[^/*\\s/?#@:]+(?::[0-9]+)?/\\*$" }
        },
        "optional": { "$ref": "#/$defs/stringArray" }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "description": "Metadata only. Local packages cannot ship package-owned background handlers in this release.",
      "properties": {
        "messageTypes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]*:(?:[A-Za-z0-9._-]+|\\*)$" }
        },
        "services": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissionNotes", "dataNotes", "localStorageNotes", "privacyLabels"],
      "properties": {
        "permissionNotes": { "$ref": "#/$defs/stringArray" },
        "dataNotes": { "$ref": "#/$defs/stringArray" },
        "localStorageNotes": { "$ref": "#/$defs/stringArray" },
        "remoteServices": { "$ref": "#/$defs/stringArray" },
        "privacyLabels": {
          "type": "array",
          "items": { "enum": ["local-only", "browser-session", "remote-api", "local-files", "diagnostics"] }
        },
        "consentRequired": { "type": "boolean" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "id": { "type": "string" },
              "path": { "$ref": "#/$defs/relativePath" },
              "kind": { "enum": ["icon", "image", "style", "font", "audio", "worker", "wasm", "html", "other"] },
              "webAccessible": { "type": "boolean" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "webAccessibleAssets": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["local", "reviewed", "blocked"] },
        "sourceUrl": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "(^|/|\\\\)\\.\\.($|/|\\\\)" }
        ]
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "surface": {
      "enum": ["tweet", "xArticle", "userCell", "notification", "directMessage", "profile", "route", "overlayApp"]
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "scope", "location", "storage", "control", "reset"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "scope": { "enum": ["global", "app", "feature"] },
        "location": { "enum": ["appearance", "appsAndFeatures", "appSurface", "advanced"] },
        "role": { "enum": ["preference", "enablement", "open", "reset"] },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["area", "key"],
          "properties": {
            "area": { "enum": ["local", "sync"] },
            "key": { "type": "string", "minLength": 1 },
            "property": { "type": "string" }
          }
        },
        "defaultValue": {},
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["toggle", "select", "segmented", "slider", "number", "text", "textarea", "action", "status"] },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": ["string", "number", "boolean", "null"] },
                  "label": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "dynamicOptions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "valueField", "labelField"],
              "properties": {
                "provider": { "enum": ["webSpeechVoices"] },
                "valueField": { "enum": ["voiceURI"] },
                "labelField": { "enum": ["name"] },
                "descriptionField": { "enum": ["lang"] },
                "refreshEvent": { "enum": ["voiceschanged"] },
                "portability": { "enum": ["browserProfile", "machineLocal"] }
              }
            },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" },
            "placeholder": { "type": "string" }
          }
        },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["behavior"],
          "properties": {
            "behavior": { "enum": ["removeKey", "restoreDefault", "restoreAppDefault", "custom"] },
            "warning": { "type": "string" }
          }
        },
        "presets": {
          "type": "array",
          "items": { "enum": ["visual", "audio", "performance", "firstRun", "profilePack"] }
        },
        "presetBehavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overwriteWarning": { "type": "string" },
            "saveAsCustom": { "type": "boolean" }
          }
        },
        "advanced": { "type": "boolean" },
        "requires": { "$ref": "#/$defs/stringArray" }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "shortDescription", "rail", "presets"],
      "properties": {
        "category": { "enum": ["appearance", "reading", "social", "game", "media", "developer"] },
        "shortDescription": { "type": "string", "minLength": 1 },
        "longDescription": { "type": "string" },
        "rail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "defaultPinned"],
          "properties": {
            "supported": { "type": "boolean" },
            "defaultPinned": { "type": "boolean" }
          }
        },
        "presets": {
          "type": "array",
          "items": { "enum": ["lite", "balanced", "full"] },
          "minItems": 1
        },
        "permissionNotes": { "$ref": "#/$defs/stringArray" },
        "dataNotes": { "$ref": "#/$defs/stringArray" },
        "remoteServices": { "$ref": "#/$defs/stringArray" },
        "localStorageNotes": { "$ref": "#/$defs/stringArray" },
        "privacyLabels": {
          "type": "array",
          "items": { "enum": ["local-only", "browser-session", "remote-api", "local-files", "diagnostics"] }
        }
      }
    }
  }
}
