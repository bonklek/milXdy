{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonklek/milXdy/blob/main/docs/schemas/milxdy-selection.schema.json",
  "title": "milXdy local maintainer-catalog selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalog", "build", "packages"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "recipeId"],
      "properties": {
        "target": { "const": "chromium" },
        "recipeId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
      }
    },
    "packages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "packageSha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$"
          },
          "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
