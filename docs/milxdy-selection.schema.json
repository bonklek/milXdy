{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonklek/milXdy/blob/main/docs/milxdy-selection.schema.json",
  "title": "milXdy catalog selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "packages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "filename", "sha256", "review"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}\\.zip$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "date"],
            "properties": {
              "identity": { "type": "string", "minLength": 1, "maxLength": 120 },
              "date": { "type": "string", "format": "date" }
            }
          }
        }
      }
    }
  }
}
