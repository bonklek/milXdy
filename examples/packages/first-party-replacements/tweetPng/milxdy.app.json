{
  "manifestVersion": 1,
  "id": "tweetPng",
  "name": "Share Kit",
  "version": "0.2.4",
  "description": "Reviews and exports local PNGs from declared X post share actions.",
  "packageKind": "feature",
  "sdk": {
    "minVersion": "0.2.4",
    "targetVersion": "0.2.4",
    "notes": [
      "Uses the generic contextual post-action contract; the package owns all Tweet PNG UI and rendering."
    ]
  },
  "contentEntry": "dist/content.js",
  "defaultEnabled": true,
  "storageKeys": {
    "local": [
      "milxdy.shareKit.enabled",
      "milxdy.settings.reskinProfile",
      "milxdy.settings.visualTheme"
    ]
  },
  "settings": [
    {
      "id": "shareKit.enabled",
      "label": "Enable Share Kit",
      "description": "Show Share Kit in the contextual X post share menu.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "role": "enablement",
      "storage": { "area": "local", "key": "milxdy.shareKit.enabled" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["firstRun", "profilePack"]
    },
    {
      "id": "tweetPng.includeImages",
      "label": "Include post images",
      "description": "Include post media and video thumbnails in reviewed PNG exports.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngIncludeImages" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.includeQuoteText",
      "label": "Include QRT",
      "description": "Include quoted-post text in reviewed PNG exports.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngIncludeQuoteText" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.includeQuoteImages",
      "label": "Include QRT image",
      "description": "Include quoted-post media and video thumbnails in reviewed PNG exports.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngIncludeQuoteImages" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.shrinkTallImages",
      "label": "Shrink tall images",
      "description": "Keep portrait media within a compact export card.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngShrinkTallImages" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.includeDate",
      "label": "Include date",
      "description": "Show the visible post date in reviewed PNG exports.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngIncludeDate" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.includeWatermark",
      "label": "Include milXdy watermark",
      "description": "Show a small milXdy mark in the lower-right pink export margin.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngIncludeWatermark" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.includeStats",
      "label": "Include stats",
      "description": "Show visible RemiStats values in reviewed PNG exports.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngIncludeStats" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.border",
      "label": "Export border",
      "description": "Draw the configured border around reviewed PNG exports.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngBorder" },
      "defaultValue": true,
      "control": { "type": "toggle" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.borderPalette",
      "label": "Border palette",
      "description": "Palette used for reviewed PNG export borders.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngBorderPalette" },
      "defaultValue": "purple",
      "control": {
        "type": "select",
        "options": [
          { "value": "purple", "label": "Purple" },
          { "value": "gray", "label": "Gray" },
          { "value": "blue", "label": "Blue" },
          { "value": "green", "label": "Green" }
        ]
      },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.backgroundColor",
      "label": "PNG background color",
      "description": "Six-digit hexadecimal background color used by Share Kit.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngBackgroundColor" },
      "defaultValue": "#fffaff",
      "control": { "type": "text", "placeholder": "#fffaff" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    },
    {
      "id": "tweetPng.fontColor",
      "label": "PNG font color",
      "description": "Six-digit hexadecimal font color used by Share Kit.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": { "area": "local", "key": "milxdy.settings.visualTheme", "property": "tweetPngFontColor" },
      "defaultValue": "#20122f",
      "control": { "type": "text", "placeholder": "#20122f" },
      "reset": { "behavior": "restoreDefault" },
      "presets": ["visual", "profilePack"]
    }
  ],
  "contextualPostActions": [
    {
      "id": "reviewPng",
      "label": "Share as PNG",
      "placement": "shareMenu",
      "icon": "assets/tweet-png-icon.svg"
    }
  ],
  "surfaces": [],
  "lifecycle": {
    "mode": "invoked",
    "invokedBy": "userAction",
    "reason": "userAction:contextualPost:reviewPng",
    "localOnly": true,
    "notes": [
      "Loaded only after the user chooses the declared X share-menu action."
    ]
  },
  "siteScopes": [
    {
      "site": "x",
      "hosts": ["https://x.com/*", "https://twitter.com/*"],
      "integration": "contentScript",
      "surfaces": ["tweet"],
      "presentation": "userAction",
      "notes": [
        "Receives only the post selected through the host-owned contextual action."
      ]
    }
  ],
  "cost": {
    "startup": "moderate",
    "perSurface": "cheap",
    "network": "none",
    "worker": "none",
    "domWrite": "large"
  },
  "loadTriggers": ["userAction"],
  "chrome": {
    "nativeStyle": "native",
    "supportedStyles": ["native"],
    "notes": ["Share Kit owns its local preview and settings dialog."]
  },
  "hub": {
    "category": "media",
    "shortDescription": "Review and export a local PNG from a post share action.",
    "rail": { "supported": false, "defaultPinned": false },
    "presets": ["balanced", "full"],
    "dataNotes": ["Renders selected post content locally after explicit user action."],
    "localStorageNotes": ["Preserves existing Tweet PNG visual/profile settings and Share Kit enablement."],
    "privacyLabels": ["local-only"]
  },
  "privacy": {
    "permissionNotes": [],
    "dataNotes": ["Renders selected post content locally after explicit user action."],
    "localStorageNotes": ["Preserves existing Tweet PNG visual/profile settings and Share Kit enablement."],
    "remoteServices": [],
    "privacyLabels": ["local-only"],
    "consentRequired": false
  },
  "package": {
    "assets": [
      { "id": "shareKit.icon", "path": "assets/tweet-png-icon.svg", "kind": "icon", "webAccessible": true },
      { "id": "shareKit.remistatsStar", "path": "assets/remistats-star.svg", "kind": "image", "webAccessible": true }
    ],
    "webAccessibleAssets": ["assets/tweet-png-icon.svg", "assets/remistats-star.svg"]
  },
  "review": {
    "status": "reviewed",
    "reviewedBy": "milxdy-first-party-share-kit",
    "reviewedAt": "2026-07-30",
    "notes": [
      "First-party replacement preserving the stable tweetPng package and setting IDs."
    ]
  }
}
