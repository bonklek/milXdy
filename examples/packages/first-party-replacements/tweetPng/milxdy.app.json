{
  "manifestVersion": 1,
  "id": "tweetPng",
  "name": "Tweet PNG",
  "version": "0.1.5",
  "description": "Renders local PNG exports from X share actions when invoked by the user.",
  "packageKind": "feature",
  "sdk": {
    "minVersion": "0.2.3",
    "targetVersion": "0.2.3",
    "notes": [
      "Pilot fixture for the prepared local App SDK package shape."
    ]
  },
  "contentEntry": "dist/content.js",
  "defaultEnabled": true,
  "storageKeys": {
    "local": [
      "milxdy.settings.reskinProfile",
      "milxdy.settings.visualTheme"
    ]
  },
  "settings": [
    {
      "id": "tweetPng.includeImages",
      "label": "Include post images",
      "description": "Include post media in reviewed Tweet PNG exports.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": {
        "area": "local",
        "key": "milxdy.settings.visualTheme",
        "property": "tweetPngIncludeImages"
      },
      "defaultValue": true,
      "control": {
        "type": "toggle"
      },
      "reset": {
        "behavior": "restoreDefault"
      },
      "presets": [
        "visual",
        "profilePack"
      ]
    },
    {
      "id": "tweetPng.includeDate",
      "label": "Include date",
      "description": "Show the visible post date in Tweet PNG exports.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": {
        "area": "local",
        "key": "milxdy.settings.visualTheme",
        "property": "tweetPngIncludeDate"
      },
      "defaultValue": true,
      "control": {
        "type": "toggle"
      },
      "reset": {
        "behavior": "restoreDefault"
      },
      "presets": [
        "visual",
        "profilePack"
      ]
    },
    {
      "id": "tweetPng.borderPalette",
      "label": "Border palette",
      "description": "Palette used for Tweet PNG export borders.",
      "scope": "feature",
      "location": "appsAndFeatures",
      "storage": {
        "area": "local",
        "key": "milxdy.settings.visualTheme",
        "property": "tweetPngBorderPalette"
      },
      "defaultValue": "purple",
      "control": {
        "type": "select",
        "options": [
          {
            "value": "purple",
            "label": "Purple"
          },
          {
            "value": "gray",
            "label": "Gray"
          },
          {
            "value": "blue",
            "label": "Blue"
          },
          {
            "value": "green",
            "label": "Green"
          }
        ]
      },
      "reset": {
        "behavior": "restoreDefault"
      },
      "presets": [
        "visual",
        "profilePack"
      ]
    }
  ],
  "surfaces": [],
  "lifecycle": {
    "mode": "invoked",
    "invokedBy": "userAction",
    "ownerAppId": "rootVisuals",
    "reason": "userAction:tweetPngShare",
    "localOnly": true,
    "notes": [
      "Loaded only after a user chooses the X share-menu Tweet PNG action."
    ]
  },
  "siteScopes": [
    {
      "site": "x",
      "hosts": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "integration": "contentScript",
      "surfaces": [
        "tweet"
      ],
      "presentation": "userAction",
      "notes": [
        "Uses the selected X post element supplied by the user-initiated share menu; it is not scanner-delivered or preloaded."
      ]
    }
  ],
  "cost": {
    "startup": "moderate",
    "perSurface": "cheap",
    "network": "none",
    "worker": "none",
    "domWrite": "large"
  },
  "loadTriggers": [
    "userAction"
  ],
  "chrome": {
    "nativeStyle": "native",
    "supportedStyles": [
      "native"
    ],
    "notes": [
      "Invoked export UI should use its authored preview/export chrome."
    ]
  },
  "hub": {
    "category": "media",
    "shortDescription": "Export a reviewed local PNG from a post share action.",
    "rail": {
      "supported": false,
      "defaultPinned": false
    },
    "presets": [
      "balanced",
      "full"
    ],
    "dataNotes": [
      "Renders selected post content locally after user action."
    ],
    "localStorageNotes": [
      "Uses appearance settings for export styling."
    ],
    "privacyLabels": [
      "local-only"
    ]
  },
  "privacy": {
    "permissionNotes": [],
    "dataNotes": [
      "Renders selected post content locally after user action."
    ],
    "localStorageNotes": [
      "Uses appearance settings for export styling."
    ],
    "remoteServices": [],
    "privacyLabels": [
      "local-only"
    ],
    "consentRequired": false
  },
  "package": {
    "assets": [
      {
        "id": "tweetPng.icon",
        "path": "assets/tweet-png-icon.svg",
        "kind": "icon",
        "webAccessible": true
      }
    ],
    "webAccessibleAssets": [
      "assets/tweet-png-icon.svg"
    ]
  },
  "review": {
    "status": "reviewed",
    "reviewedBy": "milxdy-local-app-pilot",
    "reviewedAt": "2026-07-03",
    "notes": [
      "First-party pilot fixture converted from src/platform/app-sdk/first-party-apps.json metadata."
    ]
  }
}
