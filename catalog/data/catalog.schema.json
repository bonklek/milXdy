{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bonklek.github.io/milXdy/data/catalog.schema.json",
  "title": "milXdy maintainer add-ons catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "revision",
    "catalogStatus",
    "supportedBuildTargets",
    "buildRecipes",
    "sections"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "catalogId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "catalogStatus": { "enum": ["preview", "live"] },
    "supportedBuildTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "chromium" }
    },
    "buildRecipes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/buildRecipe" }
    },
    "sections": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "buildRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "prepareCommand", "applyCommand", "outputDirectory"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "target": { "const": "chromium" },
        "prepareCommand": { "type": "string", "minLength": 1 },
        "applyCommand": { "type": "string", "minLength": 1 },
        "outputDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "packages"],
      "properties": {
        "id": { "enum": ["official", "approved-external"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/package" }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "icon",
        "summary",
        "packageKind",
        "version",
        "sdk",
        "availability",
        "publisher",
        "source",
        "artifact",
        "review",
        "capabilities",
        "permissions",
        "siteScopes",
        "remoteServices",
        "storage",
        "privacyNotes",
        "dependencies",
        "conflicts",
        "replacement",
        "blockers"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt"],
          "properties": {
            "src": { "type": "string", "pattern": "^assets/addons/[A-Za-z0-9._-]+\\.svg$" },
            "alt": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "packageKind": { "enum": ["app", "feature", "theme"] },
        "version": {
          "oneOf": [
            { "$ref": "#/$defs/semver" },
            { "type": "null" }
          ]
        },
        "sdk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minVersion", "targetVersion"],
          "properties": {
            "minVersion": {
              "oneOf": [
                { "$ref": "#/$defs/semver" },
                { "type": "null" }
              ]
            },
            "targetVersion": {
              "oneOf": [
                { "$ref": "#/$defs/semver" },
                { "type": "null" }
              ]
            }
          }
        },
        "availability": {
          "enum": [
            "planned",
            "experimental",
            "under-review",
            "published",
            "incompatible",
            "unavailable",
            "deprecated",
            "blocked"
          ]
        },
        "publisher": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryUrl", "path", "issues"],
          "properties": {
            "repositoryUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
            "path": {
              "oneOf": [
                { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
                { "type": "null" }
              ]
            },
            "issues": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" }
            }
          }
        },
        "artifact": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "packageSha256", "recipeId"],
              "properties": {
                "kind": { "const": "maintainer-source" },
                "path": { "type": "string", "pattern": "^packages/maintainer/[A-Za-z0-9._/-]+$" },
                "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "recipeId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
              }
            }
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "notes"],
          "properties": {
            "status": { "enum": ["not-started", "in-progress", "approved", "blocked"] },
            "reviewedBy": { "type": "string", "minLength": 1 },
            "reviewedAt": { "type": "string", "format": "date" },
            "notes": { "$ref": "#/$defs/stringArray" }
          }
        },
        "capabilities": { "$ref": "#/$defs/stringArray" },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts", "optional", "privilegedSurfaces", "notes"],
          "properties": {
            "hosts": { "$ref": "#/$defs/stringArray" },
            "optional": { "$ref": "#/$defs/stringArray" },
            "privilegedSurfaces": { "$ref": "#/$defs/stringArray" },
            "notes": { "$ref": "#/$defs/stringArray" }
          }
        },
        "siteScopes": { "$ref": "#/$defs/stringArray" },
        "remoteServices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "origin", "purpose", "dataSent"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "origin": { "type": "string", "format": "uri", "pattern": "^https://" },
              "purpose": { "type": "string", "minLength": 1 },
              "dataSent": { "type": "string", "minLength": 1 }
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local", "sync", "session", "notes"],
          "properties": {
            "local": { "$ref": "#/$defs/stringArray" },
            "sync": { "$ref": "#/$defs/stringArray" },
            "session": { "$ref": "#/$defs/stringArray" },
            "notes": { "$ref": "#/$defs/stringArray" }
          }
        },
        "privacyNotes": { "$ref": "#/$defs/stringArray" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "reason"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
              "version": { "$ref": "#/$defs/semver" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "replacement": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["firstPartyId", "policy", "acknowledgement"],
              "properties": {
                "firstPartyId": { "type": "string", "minLength": 1 },
                "policy": { "const": "replace-reviewed-first-party-id" },
                "acknowledgement": { "const": "--acknowledge-first-party-replacement" }
              }
            }
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issue", "reason"],
            "properties": {
              "issue": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review": {
                "properties": {
                  "status": { "const": "approved" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "review": {
                "required": ["status", "reviewedBy", "reviewedAt", "notes"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": { "const": "published" }
            }
          },
          "then": {
            "properties": {
              "version": { "$ref": "#/$defs/semver" },
              "artifact": { "type": "object" },
              "review": {
                "properties": {
                  "status": { "const": "approved" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
