{
  "schemaVersion": 1,
  "packageId": "post-reading",
  "packageVersion": "0.2.0-sdk.3",
  "sourceRepository": "https://github.com/bonklek/post-reading",
  "sourceBranch": "codex/76-audio-export-external",
  "milxdyRepository": "https://github.com/bonklek/milXdy",
  "appSdk": {
    "minVersion": "0.2.5",
    "targetVersion": "0.2.5"
  },
  "manifestVersion": 1,
  "status": "reference-preview",
  "supported": [
    "runtime lifecycle",
    "shared X surface delivery",
    "bounded rescan requests",
    "shared scheduler and cancellation",
    "routed post-reading background messages",
    "diagnostics",
    "existing settings compatibility",
    "manifest-declared active-tab page context actions"
  ],
  "reviewedExceptions": [
    "host-provided OCR frame and worker assets",
    "host-provided post-reading background handlers"
  ],
  "unsupported": [
    "ambient or package-owned arbitrary-tab injection",
    "public shared overlay/dock primitives",
    "runtime installation into an already-installed extension"
  ]
}
