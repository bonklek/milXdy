{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:milxdy:visual-elements:schema:package-lock:2",
  "title": "milXdy package visual-assets lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "source", "packageManifest", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name", "version", "location"],
      "properties": {
        "kind": { "enum": ["local-directory", "catalog-release"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "packageManifest": { "$ref": "#/$defs/relativePath" },
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["packageAssetId", "assetId", "assetVersion", "distributionScope", "licenseStatus", "licenseId", "sourceSha256", "manifestSha256", "decisionId", "exportPath", "vendoredPath", "sha256"],
        "properties": {
          "packageAssetId": { "type": "string", "minLength": 1 },
          "assetId": { "$ref": "#/$defs/catalogId" },
          "assetVersion": { "$ref": "#/$defs/semver" },
          "distributionScope": { "enum": ["local-custom", "upstream-default"] },
          "licenseStatus": { "enum": ["declared", "unknown", "not-applicable"] },
          "licenseId": { "type": ["string", "null"] },
          "sourceSha256": { "$ref": "#/$defs/sha256" },
          "manifestSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
          "decisionId": { "type": ["string", "null"] },
          "exportPath": { "$ref": "#/$defs/relativePath" },
          "vendoredPath": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "allOf": [{
          "if": { "properties": { "distributionScope": { "const": "upstream-default" } }, "required": ["distributionScope"] },
          "then": { "properties": {
            "licenseStatus": { "const": "declared" }, "licenseId": { "const": "VPL" },
            "manifestSha256": { "$ref": "#/$defs/sha256" }, "decisionId": { "type": "string", "minLength": 1 }
          } }
        }]
      }
    }
  },
  "$defs": {
    "catalogId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "not": { "anyOf": [{ "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://" }, { "pattern": "^/" }, { "pattern": "^[A-Za-z]:" }, { "pattern": "(^|[/\\\\])\\.\\.($|[/\\\\])" }] } }
  }
}
